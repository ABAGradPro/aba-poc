generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Project {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  /// Folder under WORKSPACES_DIR: the name made safe plus the first 8 characters of the id.
  folder    String    @unique
  /// Address on the management droplet: http://<droplet>/<slug>/ (Step 11). Unique so projects never overwrite each other.
  slug        String?   @unique
  liveUrl     String?
  publishedAt DateTime?
  ownerId   String    @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  versions  Version[]
  runs      Run[]

  @@index([ownerId])
}

model Version {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 1, 2, 3, ... per project. Stays the same when older rows are trimmed (only the newest 3 are kept).
  number    Int
  commitSha String
  kind      String
  summary   String
  createdAt DateTime @default(now())

  @@unique([projectId, number])
  @@index([projectId, createdAt])
}

model Run {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hermesRunId String?
  prompt      String
  status      String
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
}
